# Qless Environment Variables Configuration
# Copy this file to .env and replace placeholders with your actual keys.

# Supabase Configuration (Free tier available at https://supabase.com)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Supabase Service Role Key (Used ONLY on secure server-side Node.js tasks, never exposed in client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key for AI Service Assistant (Free tier at https://aistudio.google.com)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
VITE_APP_NAME=Qless
VITE_APP_URL=http://localhost:5173
VITE_ENABLE_DEMO_MODE=true

# Notification Providers (Optional - can be configured later)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SENDGRID_API_KEY=
